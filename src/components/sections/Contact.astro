---
import { getCollection } from 'astro:content';
import SectionTitle from '../ui/SectionTitle.astro';
import Card from '../ui/Card.astro';
import SocialLinks from '../ui/SocialLinks.astro';

const contactos = (await getCollection('contactos')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

const empresa = await getCollection('empresa');
const general = empresa.find(e => e.slug === 'contacto-general')?.data;

// Only decoration: any area not listed here still renders with the neutral fallback,
// so new contacts can be created from the CMS without touching this file.
const areaInfo = {
  presidente: { label: 'Presidencia', icon: 'crown', color: 'from-amber-400 to-orange-500' },
  direccion: { label: 'Dirección', icon: 'crown', color: 'from-amber-400 to-orange-500' },
  juridica: { label: 'Departamento Jurídico', icon: 'scale', color: 'from-blue-400 to-blue-600' },
  rrhh: { label: 'Recursos Humanos', icon: 'users', color: 'from-emerald-400 to-emerald-600' },
  economia: { label: 'Economía y Finanzas', icon: 'trending', color: 'from-violet-400 to-violet-600' },
  comercial: { label: 'Comercial', icon: 'trending', color: 'from-cyan-400 to-blue-500' },
  proyectos: { label: 'Proyectos', icon: 'folder', color: 'from-rose-400 to-pink-500' },
};

const fallbackArea = { label: '', icon: 'users', color: 'from-eict-cyan to-eict-purple-light' };

const iconPaths = {
  crown: 'M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  scale: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3',
  users: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  trending: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  folder: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
};

const emails = [general?.email_general].filter(Boolean);
const redes = general?.redes ?? [];
const hasSocial = redes.length > 0;
---

<section id="contacto" class="py-24 bg-gray-50/50 dark:bg-slate-900">
  <div class="container mx-auto px-4">
    <SectionTitle
      title="Contáctanos"
      subtitle="Comunícate directamente con el área que necesitas. Estamos listos para atenderte."
      centered
    />

    <div class="flex flex-wrap justify-center gap-6 mb-14">
      {contactos.map((c) => {
        const info = areaInfo[c.data.area] ?? fallbackArea;
        return (
          <Card hover="glow" class="group w-full sm:w-[320px]">
            <div class="p-6">
              <div class="flex items-center gap-4 mb-4">
                {c.data.photo ? (
                  <img
                    src={c.data.photo}
                    alt={c.data.name ?? c.data.position}
                    loading="lazy"
                    class="w-14 h-14 rounded-2xl object-cover shadow-lg shrink-0"
                  />
                ) : (
                  <div class={`w-14 h-14 bg-gradient-to-br ${info.color} rounded-2xl flex items-center justify-center shadow-lg shrink-0`}>
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPaths[info.icon] ?? iconPaths.users} />
                    </svg>
                  </div>
                )}
                <div class="min-w-0">
                  <h3 class="text-base font-bold text-eict-purple dark:text-white leading-tight truncate">
                    {c.data.name ?? c.data.position}
                  </h3>
                  {c.data.name && (
                    <p class="text-sm text-gray-500 dark:text-gray-400 truncate">{c.data.position}</p>
                  )}
                  {info.label && (
                    <p class="text-xs text-eict-cyan font-medium mt-0.5 truncate">{info.label}</p>
                  )}
                </div>
              </div>
              <div class="space-y-2.5">
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wider font-medium">Email</p>
                  <div class="flex items-center justify-between gap-1">
                    <a href={`mailto:${c.data.email}`} class="text-sm text-eict-cyan hover:underline truncate">
                      {c.data.email}
                    </a>
                    <button
                      class="shrink-0 p-1 text-gray-400 hover:text-eict-cyan transition-colors duration-200 copy-btn"
                      data-copy={c.data.email}
                      aria-label="Copiar email"
                      title="Copiar email"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </button>
                  </div>
                </div>
                <div>
                  <p class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wider font-medium">Teléfono</p>
                  <div class="flex items-center justify-between gap-1">
                    <a href={`tel:${c.data.phone}`} class="text-sm text-gray-700 dark:text-gray-300 hover:text-eict-cyan transition-colors duration-200">
                      {c.data.phone}
                    </a>
                    <button
                      class="shrink-0 p-1 text-gray-400 hover:text-eict-cyan transition-colors duration-200 copy-btn"
                      data-copy={c.data.phone}
                      aria-label="Copiar teléfono"
                      title="Copiar teléfono"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </button>
                  </div>
                </div>
                {c.data.schedule && (
                  <div class="pt-1">
                    <p class="text-xs text-gray-400 dark:text-gray-500 uppercase tracking-wider font-medium">Horario</p>
                    <p class="text-sm text-gray-500 dark:text-gray-400">{c.data.schedule}</p>
                  </div>
                )}
              </div>
            </div>
          </Card>
        );
      })}
    </div>

    <div class="bg-white dark:bg-slate-800/80 rounded-2xl p-8 md:p-10 shadow-lg border border-gray-100 dark:border-slate-700/50">
      <div class={`grid grid-cols-1 gap-10 ${hasSocial ? 'md:grid-cols-2' : ''}`}>
        <div class="space-y-6">
          <div>
            <h4 class="text-lg font-bold text-eict-purple dark:text-white mb-1">Dirección</h4>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Oficinas centrales</p>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-eict-cyan/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-eict-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{general?.direccion}</p>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-eict-cyan/10 rounded-xl flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-eict-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              {emails.map(email => (
                <a href={`mailto:${email}`} class="block text-sm text-eict-cyan hover:underline">{email}</a>
              ))}
            </div>
          </div>
        </div>
        {hasSocial && (
          <div class="space-y-6">
            <div>
              <h4 class="text-lg font-bold text-eict-purple dark:text-white mb-1">Síguenos</h4>
              <p class="text-gray-500 dark:text-gray-400 text-sm">Conéctate con nosotros en redes sociales</p>
            </div>
            <SocialLinks redes={redes} variant="light" size="lg" class="gap-4" />
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        await navigator.clipboard.writeText(text);
        const original = btn.innerHTML;
        btn.innerHTML = '<svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>';
        setTimeout(() => {
          btn.innerHTML = original;
        }, 2000);
      }
    });
  });
</script>