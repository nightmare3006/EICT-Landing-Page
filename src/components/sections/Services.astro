---
import { getCollection } from 'astro:content';
import SectionTitle from '../ui/SectionTitle.astro';
import Card from '../ui/Card.astro';

const entries = (await getCollection('servicios')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

// Each service needs its rendered markdown body for the detail modal.
const servicios = await Promise.all(
  entries.map(async entry => ({
    entry,
    Content: (await entry.render()).Content,
  }))
);

const iconMap = {
  users: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  flask: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  calendar: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  folder: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
  globe: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
};
---

<section id="servicios" class="py-24 bg-gray-50/50 dark:bg-slate-800/50">
  <div class="container mx-auto px-4">
    <SectionTitle
      title="Nuestros Servicios"
      subtitle="Soluciones científico-técnicas para impulsar tu empresa"
      centered
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:justify-items-center">
      {servicios.map(({ entry }) => (
        <Card class="group w-full max-w-md lg:max-w-none">
          <button
            type="button"
            class="flex flex-col w-full h-full p-8 text-left rounded-2xl focus:outline-none focus-visible:ring-2 focus-visible:ring-eict-cyan focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-800"
            data-modal-open={entry.slug}
            aria-haspopup="dialog"
          >
            <div class="w-14 h-14 bg-gradient-to-br from-eict-cyan/20 to-eict-cyan/5 rounded-2xl flex items-center justify-center mb-6 group-hover:from-eict-cyan group-hover:to-eict-cyan-dark transition-all duration-300">
              <svg class="w-7 h-7 text-eict-cyan group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconMap[entry.data.icon] ?? iconMap.users} />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-eict-purple dark:text-white mb-3">{entry.data.title}</h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed mb-6 grow">{entry.data.description}</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-eict-cyan group-hover:text-eict-cyan-dark transition-colors duration-200">
              Ver más
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </button>
        </Card>
      ))}
    </div>
  </div>

  {servicios.map(({ entry, Content }) => (
    <div
      class="service-modal fixed inset-0 z-[60] hidden opacity-0 transition-opacity duration-200"
      id={`servicio-${entry.slug}`}
      role="dialog"
      aria-modal="true"
      aria-labelledby={`servicio-${entry.slug}-title`}
    >
      <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" data-modal-close></div>

      <div class="relative h-full w-full overflow-y-auto overscroll-contain p-4 sm:p-6 md:p-10">
        <div class="modal-panel mx-auto w-full max-w-3xl bg-white dark:bg-slate-900 rounded-3xl shadow-2xl ring-1 ring-black/5 dark:ring-white/10 scale-95 transition-transform duration-200">
          <div class="relative overflow-hidden rounded-t-3xl bg-gradient-to-br from-eict-cyan/15 via-transparent to-eict-purple/15 dark:from-eict-cyan/10 dark:to-eict-purple/20 px-6 sm:px-10 pt-10 pb-8">
            <button
              type="button"
              class="absolute top-4 right-4 p-2.5 rounded-xl text-gray-500 dark:text-gray-400 hover:text-eict-cyan hover:bg-white/70 dark:hover:bg-slate-800 transition-all duration-200"
              data-modal-close
              aria-label="Cerrar"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>

            <div class="w-16 h-16 bg-gradient-to-br from-eict-cyan to-eict-cyan-dark rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-eict-cyan/25">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconMap[entry.data.icon] ?? iconMap.users} />
              </svg>
            </div>

            <h2 id={`servicio-${entry.slug}-title`} class="text-2xl sm:text-3xl font-bold text-eict-purple dark:text-white pr-10">
              {entry.data.title}
            </h2>
            <p class="mt-3 text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
              {entry.data.description}
            </p>
            {entry.data.price && (
              <p class="mt-4 inline-block px-4 py-1.5 bg-eict-cyan/10 text-eict-cyan rounded-full text-sm font-semibold border border-eict-cyan/20">
                {entry.data.price}
              </p>
            )}
          </div>

          <div class="px-6 sm:px-10 py-8 space-y-8">
            <div class="prose dark:prose-invert max-w-none prose-headings:text-eict-purple dark:prose-headings:text-white prose-p:text-gray-600 dark:prose-p:text-gray-300 prose-strong:text-eict-purple dark:prose-strong:text-white prose-a:text-eict-cyan">
              <Content />
            </div>

            {entry.data.gallery && entry.data.gallery.length > 0 && (
              <div>
                <h3 class="text-sm font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-4">Galería</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {entry.data.gallery.map(item => (
                    <figure class="group/img overflow-hidden rounded-2xl bg-eict-gray-light/40 dark:bg-slate-800">
                      <img
                        src={item.image}
                        alt={item.caption ?? entry.data.title}
                        loading="lazy"
                        class="w-full h-48 object-cover group-hover/img:scale-105 transition-transform duration-500"
                      />
                      {item.caption && (
                        <figcaption class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                          {item.caption}
                        </figcaption>
                      )}
                    </figure>
                  ))}
                </div>
              </div>
            )}

            <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-gray-100 dark:border-slate-700/60">
              <a
                href="#contacto"
                data-modal-close
                class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-eict-cyan hover:bg-eict-cyan-dark text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-eict-cyan/25"
              >
                Solicitar información
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
              <button
                type="button"
                data-modal-close
                class="inline-flex items-center justify-center px-6 py-3 text-gray-600 dark:text-gray-300 hover:text-eict-cyan font-semibold rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800 transition-all duration-200"
              >
                Cerrar
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}
</section>

<script>
  const modals = document.querySelectorAll<HTMLElement>('.service-modal');
  let lastFocused: HTMLElement | null = null;

  function openModal(modal: HTMLElement) {
    lastFocused = document.activeElement as HTMLElement;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    // Let the browser paint the hidden->block change before transitioning in.
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.querySelector('.modal-panel')?.classList.remove('scale-95');
    });
    modal.querySelector<HTMLElement>('[data-modal-close]')?.focus();
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.add('opacity-0');
    modal.querySelector('.modal-panel')?.classList.add('scale-95');
    document.body.style.overflow = '';
    setTimeout(() => modal.classList.add('hidden'), 200);
    lastFocused?.focus();
  }

  function closeAll() {
    modals.forEach(m => {
      if (!m.classList.contains('hidden')) closeModal(m);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-modal-open]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const slug = trigger.getAttribute('data-modal-open');
      const modal = document.getElementById(`servicio-${slug}`);
      if (modal) openModal(modal);
    });
  });

  modals.forEach(modal => {
    modal.querySelectorAll('[data-modal-close]').forEach(el => {
      el.addEventListener('click', () => closeModal(modal));
    });

    // Keep Tab focus inside the open dialog.
    modal.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusables = modal.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>
