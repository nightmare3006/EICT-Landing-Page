const known = redes.filter(r => r?.url && platforms[r.plataforma]);

const box =
  size === 'lg'
    ? 'w-14 h-14 rounded-2xl'
    : 'w-9 h-9 rounded-xl';
const icon = size === 'lg' ? 'w-7 h-7' : 'w-4 h-4';

const skin =
  variant === 'dark'
    ? 'bg-white/10 backdrop-blur-sm text-white hover:bg-eict-cyan hover:text-white'
    : 'bg-gradient-to-br from-eict-cyan/10 to-eict-cyan/5 text-eict-cyan hover:from-eict-cyan hover:to-eict-cyan-dark hover:text-white shadow-sm';
---

{known.length > 0 && (
  <div class={`flex flex-wrap gap-3 ${className}`}>
    {known.map(red => {
      const p = platforms[red.plataforma];
      return (
        <a
          href={red.url}
          target="_blank"
          rel="noopener noreferrer"
          class={`${box} ${skin} flex items-center justify-center transition-all duration-300 hover:scale-105`}
          aria-label={p.label}
          title={p.label}
        >
          <svg class={icon} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d={p.path} />
          </svg>
        </a>
      );
    })}
  </div>
)}
