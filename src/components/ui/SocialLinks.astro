---
interface Red {
  plataforma: string;
  url: string;
}

interface Props {
  redes?: Red[];
  variant?: 'light' | 'dark';
  size?: 'sm' | 'lg';
  class?: string;
}

const { redes = [], variant = 'light', size = 'lg', class: className = '' } = Astro.props;

// Adding a platform here plus in the admin's "Plataforma" select is all it takes
// to switch on Instagram, X, Threads… later — no other file needs to change.
const platforms: Record<string, { label: string; path: string; filled: boolean }> = {
  facebook: {
    label: 'Facebook',
    filled: true,
    path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z',
  },
  linkedin: {
    label: 'LinkedIn',
    filled: true,
