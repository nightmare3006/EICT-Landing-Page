---
interface GalleryItem {
  image: string;
  caption?: string;
}

interface Props {
  /** Unique DOM id; the matching trigger uses data-modal-open="<id>". */
  id: string;
  title: string;
  description?: string;
  /** SVG path drawn in the header badge. Ignored when `image` is set. */
  iconPath?: string;
  /** Featured image, shown as a cover above the header instead of the icon. */
  image?: string;
  price?: string;
  badge?: { label: string; tone?: 'ok' | 'muted' };
  gallery?: GalleryItem[];
  cta?: string;
}

const {
  id,
  title,
  description,
  iconPath,
  image,
  price,
  badge,
  gallery = [],
  cta = 'Solicitar información',
} = Astro.props;

const badgeTone =
  badge?.tone === 'muted'
    ? 'bg-gray-100 text-gray-500 border-gray-200 dark:bg-slate-800 dark:text-gray-400 dark:border-slate-700'
    : 'bg-emerald-50 text-emerald-600 border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/20';
---

<div
  class="detail-modal fixed inset-0 z-[60] hidden opacity-0 transition-opacity duration-200"
  id={id}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
>
  <div class="absolute inset-0 bg-slate-950/60 backdrop-blur-sm" data-modal-close></div>

  <div class="relative h-full w-full overflow-y-auto overscroll-contain p-4 sm:p-6 md:p-10">
    <div class="modal-panel relative mx-auto w-full max-w-3xl bg-white dark:bg-slate-900 rounded-3xl shadow-2xl ring-1 ring-black/5 dark:ring-white/10 scale-95 transition-transform duration-200">
      <button
        type="button"
        class="absolute top-4 right-4 z-10 p-2.5 rounded-xl bg-white/80 dark:bg-slate-800/80 backdrop-blur text-gray-500 dark:text-gray-300 hover:text-eict-cyan shadow-sm transition-all duration-200"
        data-modal-close
        aria-label="Cerrar"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      {image && (
        <img
          src={image}
          alt={title}
          loading="lazy"
          class="w-full h-56 sm:h-64 object-cover rounded-t-3xl"
        />
      )}

      <div class={`relative overflow-hidden px-6 sm:px-10 pt-8 pb-8 bg-gradient-to-br from-eict-cyan/15 via-transparent to-eict-purple/15 dark:from-eict-cyan/10 dark:to-eict-purple/20 ${image ? '' : 'rounded-t-3xl pt-10'}`}>
        {!image && iconPath && (
          <div class="w-16 h-16 bg-gradient-to-br from-eict-cyan to-eict-cyan-dark rounded-2xl flex items-center justify-center mb-5 shadow-lg shadow-eict-cyan/25">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={iconPath} />
            </svg>
          </div>
        )}

        <h2 id={`${id}-title`} class="text-2xl sm:text-3xl font-bold text-eict-purple dark:text-white pr-10">
          {title}
        </h2>

        {description && (
          <p class="mt-3 text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">{description}</p>
        )}

        {(price || badge) && (
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {price && (
              <span class="inline-block px-4 py-1.5 bg-eict-cyan/10 text-eict-cyan rounded-full text-sm font-semibold border border-eict-cyan/20">
                {price}
              </span>
            )}
            {badge && (
              <span class={`inline-block px-4 py-1.5 rounded-full text-sm font-semibold border ${badgeTone}`}>
                {badge.label}
              </span>
            )}
          </div>
        )}
      </div>

      <div class="px-6 sm:px-10 py-8 space-y-8">
        <div class="prose dark:prose-invert max-w-none prose-headings:text-eict-purple dark:prose-headings:text-white prose-p:text-gray-600 dark:prose-p:text-gray-300 prose-strong:text-eict-purple dark:prose-strong:text-white prose-a:text-eict-cyan">
          <slot />
        </div>

        {gallery.length > 0 && (
          <div>
            <h3 class="text-sm font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-4">Galería</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {gallery.map(item => (
                <figure class="group/img overflow-hidden rounded-2xl bg-eict-gray-light/40 dark:bg-slate-800">
                  <img
                    src={item.image}
                    alt={item.caption ?? title}
                    loading="lazy"
                    class="w-full h-48 object-cover group-hover/img:scale-105 transition-transform duration-500"
                  />
                  {item.caption && (
                    <figcaption class="px-4 py-3 text-sm text-gray-500 dark:text-gray-400">
                      {item.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          </div>
        )}

        <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t border-gray-100 dark:border-slate-700/60">
          <a
            href="#contacto"
            data-modal-close
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-eict-cyan hover:bg-eict-cyan-dark text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-eict-cyan/25"
          >
            {cta}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <button
            type="button"
            data-modal-close
            class="inline-flex items-center justify-center px-6 py-3 text-gray-600 dark:text-gray-300 hover:text-eict-cyan font-semibold rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800 transition-all duration-200"
          >
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Astro bundles this once no matter how many times the component renders,
  // so a single delegated handler drives every modal on the page.
  const modals = document.querySelectorAll<HTMLElement>('.detail-modal');
  let lastFocused: HTMLElement | null = null;

  function openModal(modal: HTMLElement) {
    lastFocused = document.activeElement as HTMLElement;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    // Let the browser paint the hidden->block change before transitioning in.
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.querySelector('.modal-panel')?.classList.remove('scale-95');
    });
    modal.querySelector<HTMLElement>('[data-modal-close]')?.focus();
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.add('opacity-0');
    modal.querySelector('.modal-panel')?.classList.add('scale-95');
    document.body.style.overflow = '';
    setTimeout(() => modal.classList.add('hidden'), 200);
    lastFocused?.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-modal-open]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const modal = document.getElementById(trigger.getAttribute('data-modal-open') ?? '');
      if (modal) openModal(modal);
    });
  });

  modals.forEach(modal => {
    modal.querySelectorAll('[data-modal-close]').forEach(el => {
      el.addEventListener('click', () => closeModal(modal));
    });

    // Keep Tab focus inside the open dialog.
    modal.addEventListener('keydown', e => {
      if (e.key !== 'Tab') return;
      const focusables = modal.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  });

  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    modals.forEach(m => {
      if (!m.classList.contains('hidden')) closeModal(m);
    });
  });
</script>
