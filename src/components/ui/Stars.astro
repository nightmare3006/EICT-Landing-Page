---
interface Props {
  /** 1–5, may be fractional for an average. */
  value: number;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { value, size = 'md', class: className = '' } = Astro.props;

const dims = { sm: 'w-4 h-4', md: 'w-5 h-5', lg: 'w-6 h-6' }[size];
const STAR =
  'M11.48 3.5a.56.56 0 011.04 0l2.1 4.26a.56.56 0 00.43.31l4.7.68c.46.07.64.63.31.96l-3.4 3.31a.56.56 0 00-.17.5l.8 4.68a.56.56 0 01-.81.59l-4.2-2.21a.56.56 0 00-.53 0l-4.2 2.21a.56.56 0 01-.82-.59l.8-4.68a.56.56 0 00-.16-.5l-3.4-3.31a.56.56 0 01.3-.96l4.7-.68a.56.56 0 00.44-.31l2.1-4.26z';

const clamped = Math.max(0, Math.min(5, value));

// Clip each star on its own. Filling a percentage of the whole row would be off
// by the flex gaps, so a 4/5 rating would leak a sliver of the fifth star.
const fills = [0, 1, 2, 3, 4].map(i => Math.max(0, Math.min(1, clamped - i)));
---

<span
  class={`inline-flex gap-0.5 ${className}`}
  role="img"
  aria-label={`${clamped.toFixed(1)} de 5 estrellas`}
>
  {fills.map(fill => (
    <span class={`relative inline-block ${dims}`} aria-hidden="true">
      <svg class={`${dims} text-gray-300 dark:text-slate-600`} viewBox="0 0 24 24" fill="currentColor">
        <path d={STAR} />
      </svg>
      {fill > 0 && (
        <span class="absolute inset-0 overflow-hidden" style={`width: ${fill * 100}%`}>
          <svg class={`${dims} text-amber-400`} viewBox="0 0 24 24" fill="currentColor">
            <path d={STAR} />
          </svg>
        </span>
      )}
    </span>
  ))}
</span>
