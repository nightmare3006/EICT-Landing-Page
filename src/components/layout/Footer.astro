---
import { getCollection } from 'astro:content';
import ShareButtons from '../marketing/ShareButtons.astro';
import Logo from '../ui/Logo.astro';
import SocialLinks from '../ui/SocialLinks.astro';

const quickLinks = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Productos', href: '#productos' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Contacto', href: '#contacto' },
];

const servicios = (await getCollection('servicios')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)
);

const empresa = await getCollection('empresa');
const general = empresa.find(e => e.slug === 'contacto-general')?.data;

const telefonos = [general?.telefono_1, general?.telefono_2].filter(Boolean);
const redes = general?.redes ?? [];
const currentYear = new Date().getFullYear();
---

<footer class="bg-gradient-to-b from-eict-purple to-eict-purple-dark dark:from-slate-900 dark:to-slate-950 text-white">
  <div class="container mx-auto px-4 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center justify-center bg-white rounded-2xl p-2 shrink-0 shadow-lg shadow-black/10 ring-1 ring-black/5">
            <Logo class="h-11 w-auto" />
          </span>
          <div>
            <span class="text-xl font-bold">EICT S.A.</span>
            <p class="text-eict-cyan-light text-xs">Solucionamos con ciencia</p>
          </div>
        </div>
        <p class="text-white/60 text-sm leading-relaxed mb-6 max-w-xs">
          Sociedad de Interfaz de Ciencia y Tecnología. Conectando la investigación con la empresa para innovar y crecer.
        </p>
        <ShareButtons />
      </div>

      <div class="lg:col-span-2">
        <h3 class="text-sm font-semibold text-white/80 uppercase tracking-wider mb-5">Enlaces</h3>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/60 hover:text-eict-cyan transition-colors duration-200 text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class="text-sm font-semibold text-white/80 uppercase tracking-wider mb-5">Servicios</h3>
        <ul class="space-y-3">
          {servicios.map(servicio => (
            <li>
              <a href="#servicios" class="text-white/60 hover:text-eict-cyan transition-colors duration-200 text-sm">
                {servicio.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class="text-sm font-semibold text-white/80 uppercase tracking-wider mb-5">Contacto</h3>
        <ul class="space-y-4">
          {telefonos.length > 0 && (
            <li>
              <p class="text-xs text-white/40 uppercase tracking-wider mb-1">Teléfonos</p>
              {telefonos.map(telefono => (
                <a href={`tel:${telefono}`} class="text-white/70 hover:text-eict-cyan transition-colors duration-200 text-sm block">
                  {telefono}
                </a>
              ))}
            </li>
          )}
          {general?.email_general && (
            <li>
              <p class="text-xs text-white/40 uppercase tracking-wider mb-1">Email</p>
              <a href={`mailto:${general.email_general}`} class="text-white/70 hover:text-eict-cyan transition-colors duration-200 text-sm">
                {general.email_general}
              </a>
            </li>
          )}
        </ul>
        <SocialLinks redes={redes} variant="dark" size="sm" class="mt-6" />
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container mx-auto px-4 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-white/40 text-xs">
          © {currentYear} EICT S.A. Todos los derechos reservados.
        </p>
        <p class="text-white/40 text-xs">
          Sociedad de Interfaz de Ciencia y Tecnología · Holguín, Cuba
        </p>
      </div>
    </div>
  </div>
</footer>